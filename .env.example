# Supabase Project Settings -> Database -> Connection string -> Session pooler
# prepareThreshold=0 is required when using Supabase's transaction pooler.
SUPABASE_DB_URL=jdbc:postgresql://<pooler-host>:6543/postgres?sslmode=require&prepareThreshold=0
SUPABASE_DB_USERNAME=postgres.<project-ref>
SUPABASE_DB_PASSWORD=replace-with-your-database-password

# Supabase Storage S3 Configuration
# Storage -> Configuration -> S3 -> endpoint and region
SUPABASE_S3_ENDPOINT=https://<project-ref>.storage.supabase.co/storage/v1/s3
SUPABASE_S3_REGION=ap-south-1
SUPABASE_S3_ACCESS_KEY=replace-with-supabase-s3-access-key
SUPABASE_S3_SECRET_KEY=replace-with-supabase-s3-secret-key
SUPABASE_S3_BUCKET=submissions

# Used only when app.file.storage=local
FILE_UPLOAD_DIR=./uploads
